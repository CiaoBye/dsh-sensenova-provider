{
  "name": "@ciaobye/dsh-sensenova-provider",
  "version": "0.2.0-alpha.1",
  "description": "SenseNova LLM adapter for DeepSeek Harness 0.1.6+: multi-key rotation, 429 cooldown, 401 disable, and robust streamed tool-call repair.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./adapter": "./adapter.js",
    "./pool": "./pool.js",
    "./openai-history": "./openai-history.js",
    "./openai-sse": "./openai-sse.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "adapter.js",
    "catalog.js",
    "http.js",
    "pool.js",
    "openai-history.js",
    "sse-state.js",
    "openai-sse.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check adapter.js && node --check catalog.js && node --check http.js && node --check pool.js && node --check openai-history.js && node --check sse-state.js && node --check openai-sse.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.6-alpha.1 <0.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
